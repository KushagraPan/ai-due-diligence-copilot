# Environment Configuration Template
# Copy to .env and configure keys

# ── Application ─────────────────────────────────────────────
APP_ENV="development"          # development, staging, production
LOG_LEVEL="INFO"

# ── LLM Providers ──────────────────────────────────────────
OPENAI_API_KEY=""

# Optional: enables Tier 2 table extraction (Gemini vision fallback).
# Tier 1 local extraction and Tier 3 fallback work without this key.
GEMINI_API_KEY=""

# ── Weaviate Cloud (sole vector & lexical store) ────────────
WEAVIATE_URL=""                # Weaviate Cloud REST endpoint, including https:// (e.g. https://xxx.weaviate.network)
WEAVIATE_API_KEY=""            # Weaviate Cloud API authentication key

# ── Embedding Configuration ─────────────────────────────────
EMBEDDING_PROVIDER="openai"    # openai (default) or local_bge (requires torch + transformers)
EMBEDDING_MODEL="text-embedding-3-large"
EMBEDDING_DIMENSION=1536

# ── Retrieval & Reranking ───────────────────────────────────
HYBRID_ALPHA=0.50              # Forwarded to Weaviate hybrid search
RETRIEVAL_TOP_N=40
RERANKER_TYPE="llm"            # B5 architecture: 'llm' (single-stage fast LLM reranker)
LLM_RERANKER_MODEL="gpt-4o-mini"  # Fast LLM model used for B5 candidate reranking
RERANK_CANDIDATE_COUNT=40
RERANK_TOP_K=7

# ── LLM Generation ─────────────────────────────────────────
GENERATION_MODEL="gpt-4o"

# ── Query Rewriting ────────────────────────────────────────
QUERY_REWRITER_MODEL="gpt-4o-mini"
